{
  "Jwt": {
    //I store the secret key for jwt authentication at secrets.json .
    "Issuer": "https://localhost:7266",
    "Audience": "https://localhost:7266",
    "ExpireMinutes": 30,
    "RefreshTokenExpireDays": 7
  },
  "LoanSettings": {
    "DueDays": 30,
    "LoansLimit": 5
  },
  "FrontendUrl": "https://your-frontend-app.com",
  "EmailSettings": {
    "SmtpServer": "smtp.LibraryManagementSystem.com",
    "SmtpPort": 587
  },
  "CacheSettings": {
    "ExpirationMinutes": 10
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*", // Applies to all endpoints
        "Period": "5m", // 5 seconds
        "Limit": 3 // 3 requests
      }
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File","Serilog.Sinks.Async", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Process" ], // Add required packages
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "System": "Warning" // Good to quiet down System namespace too
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ], // Add enrichers
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            // 1. Console Sink (For Development/Containers)
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}]"
              }
            },
            // 2. File Sink (For Local Persistence/Backup)
            {
              "Name": "File",
              "Args": {
                "path": "C:\\logs\\Library\\log-.txt", // IMPORTANT: Define the path!
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 10485760, // 10 MB limit
                "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" // Structured JSON format
              }
            },
            // 3. External Sink (For Centralized Logging - e.g., Seq, Elasticsearch, Log Analytics)
            {
              "Name": "Seq",
              "Args": {
                "serverUrl": "http://localhost:5341",
                "batchPostingLimit": 1000, // Sends logs in batches of up to 1000 events
                "period": "00:00:02" // Posts every 2 seconds, regardless of batch size
              }
            }
          ],
          "bufferSize": 10000 // Optional: The maximum number of events to hold in the queue
        }
      }
    
    ]
  }

}
